{
  "name": "business-compliance-reminder",
  "version": "1.0.0",
  "description": "A bespoke compliance and document renewal tracker designed for small organizations. This platform ensures critical permits, insurance policies, and vendor agreements are actively managed without relying on a cold, corporate interface.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "server": "node --watch server.js",
    "client": "npm run dev --prefix client",
    "dev": "concurrently -n \"API,VITE\" -c \"magenta,cyan\" \"npm run server\" \"npm run client\"",
    "seed": "node seed.js",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/viswajithpanduga1607/Business-compliance-reminder.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/viswajithpanduga1607/Business-compliance-reminder/issues"
  },
  "homepage": "https://github.com/viswajithpanduga1607/Business-compliance-reminder#readme",
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "express-validator": "^7.3.2",
    "mongodb": "^7.8.0",
    "mongoose": "^9.11.4"
  },
  "devDependencies": {
    "concurrently": "^10.0.6"
  }
}
